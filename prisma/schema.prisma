generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String          @id @default(cuid())
  email            String          @unique
  passwordHash     String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  leetcodeUsername String?
  chatSessions     ChatSession[]
  dsaRecords       DsaSubmission[]
  profile          Profile?
  seriesMarks      SeriesMark[]
  studyStreak      StudyStreak?
  timetable        TimetableItem[]
}

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  fullName     String
  username     String   @unique
  college      String   @default("KTU Affiliated College")
  course       String   @default("B.Tech Computer Science & Engineering")
  semester     Int      @default(3)
  academicYear String   @default("2024-2028")
  bio          String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DsaSubmission {
  id         String   @id @default(cuid())
  userId     String
  problemId  String
  title      String
  difficulty String
  topic      String
  platform   String   @default("LeetCode")
  status     String   @default("Solved")
  notes      String?
  solvedAt   DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, topic])
  @@index([userId, difficulty])
}

model StudyStreak {
  id            String   @id @default(cuid())
  userId        String   @unique
  currentStreak Int      @default(1)
  bestStreak    Int      @default(1)
  totalDays     Int      @default(1)
  lastActiveAt  DateTime @default(now())
  activityLogs  String   @default("[]")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TimetableItem {
  id        String  @id @default(cuid())
  userId    String
  dayOfWeek String
  subject   String
  startTime String
  endTime   String
  room      String?
  isLab     Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SeriesMark {
  id          String   @id @default(cuid())
  userId      String
  seriesTest  Int
  subjectCode String
  subjectName String
  marksScored Float
  maxMarks    Float    @default(50.0)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  title     String        @default("Study Discussion")
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model EmailVerificationCode {
  id         String   @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([email])
}

model PendingSignup {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  username     String
  college      String
  course       String
  semester     Int
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}
