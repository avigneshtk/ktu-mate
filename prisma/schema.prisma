datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  passwordHash  String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  profile       Profile?
  dsaRecords    DsaSubmission[]
  studyStreak   StudyStreak?
  timetable     TimetableItem[]
  seriesMarks   SeriesMark[]
  chatSessions  ChatSession[]
}

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  username     String   @unique
  college      String   @default("KTU Affiliated College")
  course       String   @default("B.Tech Computer Science & Engineering")
  semester     Int      @default(3)
  academicYear String   @default("2024-2028")
  bio          String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DsaSubmission {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId   String
  title       String
  difficulty  String   // "Easy", "Medium", "Hard"
  topic       String   // "Arrays", "Strings", "Trees", etc.
  platform    String   @default("LeetCode") // "LeetCode", "KTU Labs", "Custom"
  status      String   @default("Solved")   // "Solved", "Attempted", "Bookmarked"
  notes       String?
  solvedAt    DateTime @default(now())

  @@index([userId, topic])
  @@index([userId, difficulty])
}

model StudyStreak {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak Int     @default(1)
  bestStreak   Int      @default(1)
  totalDays    Int      @default(1)
  lastActiveAt DateTime @default(now())
  activityLogs String   @default("[]") // JSON string of active dates
}

model TimetableItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek   String   // "Monday", "Tuesday", etc.
  subject     String
  startTime   String   // "09:00"
  endTime     String   // "10:00"
  room        String?
  isLab       Boolean  @default(false)
}

model SeriesMark {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seriesTest  Int      // 1 or 2
  subjectCode String
  subjectName String
  marksScored Float
  maxMarks    Float    @default(50.0)
  createdAt   DateTime @default(now())
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String        @default("Study Discussion")
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String      // "user" | "assistant"
  content   String
  createdAt DateTime    @default(now())
}
